# ── Backend / Frontend ────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
BACKEND_WS=ws://localhost:8000

# ── Data ──────────────────────────────────────────────────────────
POLL_INTERVAL=3
DEMO_MODE=0
DEFAULT_SYMBOL=فولاد

# ── Chart / plugins ───────────────────────────────────────────────
USER_PLAN=premium
PLUGIN_SCAN_SEC=5
CANDLE_CLOSE=final
PRICE_ADJUST=1
INCLUDE_HALTED=0

# ── LLM (هر ارائه‌دهندهٔ سازگار با OpenAI) ────────────────────────
# می‌توانید این مقادیر را در سایدبار برنامه هم وارد کنید.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_PROXY=http://127.0.0.1:7890

# اگر TSETMC پشت پروکسی/VPN در دسترس نیست:
NO_PROXY=cdn.tsetmc.com
